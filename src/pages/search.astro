---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="البحث">
  <div class="container" style="max-width:820px">
    <div class="article-body" style="margin:24px 0 40px">
      <h1>🔍 البحث</h1>
      <input type="search" id="q" placeholder="ابحث عن قالب أو دليل…"
        style="width:100%;font-size:1.15rem;padding:14px 16px;border:2px solid #e6e8f0;border-radius:10px" />
      <div id="results" style="margin-top:20px"></div>
    </div>
  </div>
  <script>
    const input = document.getElementById('q');
    const results = document.getElementById('results');
    const q = new URLSearchParams(location.search).get('q');
    if (q) input.value = q;
    const render = (INDEX) => {
      const v = input.value.trim().toLowerCase();
      if (!v) { results.innerHTML = '<p style="color:#7a8198">اكتب كلمة للبحث.</p>'; return; }
      const hits = INDEX.filter((d) => (d.t + ' ' + d.k).toLowerCase().includes(v)).slice(0, 20);
      results.innerHTML = hits.length ? hits.map((d) =>
        `<a href="${d.u}" style="display:block;padding:12px 14px;border-radius:10px;background:#f6f7fb;margin-bottom:8px;font-weight:700;color:#0f6b4f">${d.t}<span style="color:#7a8198;font-size:0.85rem"> · ${d.c}</span></a>`
      ).join('') : '<p style="color:#7a8198">لا نتائج مطابقة.</p>';
    };
    fetch('/search-index.json').then((r) => r.json()).then((INDEX) => {
      render(INDEX);
      input.addEventListener('input', () => {
        history.replaceState(null, '', '/search/?q=' + encodeURIComponent(input.value));
        render(INDEX);
      });
    });
  </script>
</BaseLayout>